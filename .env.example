# .env 템플릿 — 실제 값은 .env(커밋 안 됨)에 채운다. 여기는 변수 이름만 문서화한다.

# Resend(이메일 발송 API) — https://resend.com
RESEND_API_KEY=

# 회신 감지(H1) — Harness/hook/imap_reply_poller.py
# IMAP_PASS는 Gmail 앱 비밀번호(16자리). 일반 비밀번호로는 IMAP이 안 된다.
IMAP_USER=
IMAP_PASS=
IMAP_HOST=              # 선택, 기본 imap.gmail.com
IMAP_PORT=              # 선택, 기본 993
IMAP_MAILBOX=           # 선택, 기본 INBOX

# SMTP 대체 경로 (Harness/api/real_send_api.py) — 셋 다 없으면 세이프페일(발송 안 함)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_DEFAULT=
SMTP_USE_TLS=

# 대시보드(web/) — 선택
DASHBOARD_DATA_ROOT=
DASHBOARD_OPERATOR_NAME=
DISPATCH_MODE=          # mock(기본) | real | resend
DEMO_RECIPIENT=         # DISPATCH_MODE=resend일 때 필수. 실제 수신 주소를 무시하고 여기로만 보낸다
